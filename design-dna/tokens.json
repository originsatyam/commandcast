      "voice": {
        "rules": [
          "Sentence case, including buttons.",
          "Headlines are claims about the work, not the platform.",
          "Name the standard (Verified studios) instead of claiming trust.",
          "No exclamation marks outside community tiles.",
          "Numbers as social proof, unadorned."
        ],
        "examples": [
          "Get more creative",
          "The network for creative intelligence.",
          "Projects we love",
          "Verified studios",
          "Post a job for free — creatives apply directly.",
          "Let's go"
        ],
        "avoid": [
          "Unlock your creative potential",
          "Featured Projects",
          "Trusted Partners",
          "Hire top-tier talent today!"
        ]
      },
      "signatureMoves": [
        "2px gutters with 16px card radii: a contact sheet, not a card grid.",
        "One acid wash (#F0FB96) used as a surface, never as a foreground.",
        "Tracking that loosens as type shrinks.",
        "Full-pill actions only: 48px tall at 24px radius.",
        "Section headers at 23px, with the whitespace doing the shouting."
      ],
      "avoid": [
        "8px labels and 1.15 body leading in content surfaces.",
        "A second accent colour: a monochrome system has nowhere to hide.",
        "Colour-coded categories: imagery is the only colour source."
      ]
