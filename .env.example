# Supabase Project Connection Details
# Find these in your Supabase Dashboard under: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Supabase Personal Access Token for MCP (starts with sbp_...)
# Find or generate this at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_access_token_here

# TinyFish Fast Web Search & Headless DOM Discovery
VITE_TINYFISH_API_KEY=sk-tinyfish-your-key-here

# Firecrawl Deep Web Scraping & Requisition Extraction
VITE_FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here
